#!/usr/bin/env bash
# YourGeeky: a friendly helper for people who have to use the Terminal.
# Starts an AI assistant (Google's free Antigravity CLI, or Claude Code) with
# plain-English guidance and safety rules.
# Written for the bash 3.2 that ships with macOS.

set -euo pipefail

VERSION="0.3.0"

# Find the real install folder, even when this script is run through a symlink.
resolve_home() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}

YG_HOME="$(resolve_home)"
GUIDE="$YG_HOME/prompts/guide.md"
ENGINE_FILE="${YOURGEEKY_ENGINE_FILE:-$YG_HOME/engine}"
CLAUDE_BIN="${YOURGEEKY_CLAUDE:-claude}"
AGY_BIN="${YOURGEEKY_AGY:-agy}"
# A plain-English record of what YourGeeky has done on this Mac, kept in the
# home folder so it's easy to find in Finder.
NOTES_FILE="${YOURGEEKY_NOTES:-$HOME/YourGeeky notes.txt}"

say() { printf '%s\n' "$*"; }

usage() {
  cat <<USAGE
YourGeeky $VERSION: a friendly helper for the Terminal.

How to use it:
  yourgeeky                      Start a conversation
  yourgeeky "install Python"     Start with a request
  yourgeeky --show-commands      Also show the real commands, so you can learn them
  yourgeeky --notes              Open your notes: what YourGeeky has done for you

Choosing the AI:
  yourgeeky --use google         Use Google's free AI (the default)
  yourgeeky --use claude         Use Claude Code (needs a paid Claude plan)

Other options:
  --help       Show this message
  --version    Show the version number
USAGE
}

ask_yes_no() {
  local answer
  printf '%s [y/n] ' "$1"
  read -r answer || return 1
  case "$answer" in [Yy]*) return 0 ;; *) return 1 ;; esac
}

current_engine() {
  local engine="google"
  if [ -f "$ENGINE_FILE" ]; then
    engine="$(tr -d '[:space:]' < "$ENGINE_FILE")"
  fi
  case "$engine" in claude) say claude ;; *) say google ;; esac
}

# Make sure the chosen AI tool is installed, offering to install it if not.
ensure_engine() {
  local name bin url plan
  if [ "$1" = "claude" ]; then
    name="Claude Code"; bin="$CLAUDE_BIN"; url="https://claude.ai/install.sh"
    plan="You'll need a paid Claude plan to sign in afterwards."
  else
    name="Google's free AI (Antigravity CLI)"; bin="$AGY_BIN"; url="https://antigravity.google/cli/install.sh"
    plan="You'll sign in with a free Google account afterwards."
  fi
  if command -v "$bin" >/dev/null 2>&1; then
    return 0
  fi
  say ""
  say "YourGeeky uses $name to do its work, and it isn't installed yet."
  say "Installing it takes about a minute. $plan"
  say ""
  if ask_yes_no "Install it now?"; then
    curl -fsSL "$url" | bash
    export PATH="$HOME/.local/bin:$PATH"
    if ! command -v "$bin" >/dev/null 2>&1; then
      say "It was installed, but this window can't find it yet."
      say "Close this Terminal window, open a new one, and type: yourgeeky"
      exit 1
    fi
  else
    say "No problem. When you're ready, run yourgeeky again."
    exit 1
  fi
}

build_prompt() {
  local mode
  if [ "$1" = "show" ]; then
    mode="The person wants to learn. Show each command in a code block with a one-line plain explanation of what it does."
  else
    mode="Hide raw commands unless the person asks to see them. Describe what you are doing in plain words instead."
  fi
  local text
  text="$(cat "$GUIDE")"
  text="${text/COMMANDS_MODE/$mode}"
  printf '%s' "${text//NOTES_FILE/$NOTES_FILE}"
}

open_notes() {
  if [ ! -s "$NOTES_FILE" ]; then
    say "There are no notes yet. After YourGeeky installs or changes something for you,"
    say "it writes it down in \"$NOTES_FILE\" so you can look back later."
    return 0
  fi
  if command -v open >/dev/null 2>&1 && [ "$(uname -s)" = "Darwin" ]; then
    open -e "$NOTES_FILE"
    say "Your notes are open in TextEdit."
  else
    cat "$NOTES_FILE"
  fi
}

main() {
  local commands="hide"
  local request=""
  local use=""

  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      -v|--version) say "yourgeeky $VERSION"; exit 0 ;;
      --show-commands) commands="show" ;;
      --notes) open_notes; exit 0 ;;
      --use)
        shift
        case "${1:-}" in
          google|claude) use="$1" ;;
          *) say "Please choose google or claude, for example: yourgeeky --use google"; exit 2 ;;
        esac
        ;;
      --) shift; request="$*"; break ;;
      -*) say "I don't recognise the option $1."; say ""; usage; exit 2 ;;
      *) request="${request:+$request }$1" ;;
    esac
    shift
  done

  if [ -n "$use" ]; then
    printf '%s\n' "$use" > "$ENGINE_FILE"
    if [ "$use" = "claude" ]; then
      say "Okay, YourGeeky will use Claude Code from now on."
    else
      say "Okay, YourGeeky will use Google's free AI from now on."
    fi
    [ -z "$request" ] && [ "$commands" = "hide" ] && exit 0
  fi

  if [ "$(uname -s)" != "Darwin" ] && [ -z "${YOURGEEKY_ALLOW_ANY_OS:-}" ]; then
    say "This version of YourGeeky is made for Mac. Support for other computers is coming later."
    exit 1
  fi

  if [ ! -f "$GUIDE" ]; then
    say "YourGeeky is missing a file it needs ($GUIDE). Please reinstall it."
    exit 1
  fi

  local engine
  engine="$(current_engine)"
  ensure_engine "$engine"

  if [ "$engine" = "claude" ]; then
    say "YourGeeky is using Claude Code. (To switch to Google's free AI, type: yourgeeky --use google)"
  else
    say "YourGeeky is using Google's free AI. (To switch to Claude, type: yourgeeky --use claude)"
  fi
  say "Hi, I'm YourGeeky. Tell me what you need in plain words, like \"install Python\"."
  say "I'll explain each step and ask before changing anything."
  say ""
  say "How to answer me:"
  say "  - To say yes to a question, type y and press Return."
  say "  - When a box pops up asking to run or allow something, press Return for yes."
  say "  - To leave, type /exit (with the slash) and press Return."
  say "  - Prefer to talk? Press the microphone key (or Fn twice) and speak."
  say ""
  # The AI's screen can push this off the top, so wait until they've read it.
  if [ -t 0 ] && [ -t 1 ]; then
    printf 'Press Return to start. '
    read -r _ || true
  fi

  local prompt
  prompt="$(build_prompt "$commands")"
  local status=0
  if [ "$engine" = "claude" ]; then
    if [ -n "$request" ]; then
      "$CLAUDE_BIN" --append-system-prompt "$prompt" "$request" || status=$?
    else
      "$CLAUDE_BIN" --append-system-prompt "$prompt" || status=$?
    fi
  else
    # Antigravity CLI has no system prompt option, and whatever goes in the
    # opening message is shown on screen and in the window title. So the guide
    # goes in a file, and the opening message is one short line pointing at it.
    local guide_file="$YG_HOME/session-guide.md"
    printf '%s\n' "$prompt" > "$guide_file"
    local opening="You are YourGeeky. First, quietly read your instructions in $guide_file and follow them for this whole conversation. Don't mention the file."
    if [ -n "$request" ]; then
      opening="$opening Then help with the person's first request: $request"
    else
      opening="$opening Then greet the person in one short sentence and ask what they need help with."
    fi
    "$AGY_BIN" --add-dir "$YG_HOME" -i "$opening" || status=$?
  fi

  say ""
  say "YourGeeky has finished. You can close this window now (press Command + W)."
  return "$status"
}

main "$@"
